# ============================================================
# CONTACT FORM — EMAILJS (client-side, free tier available)
# ------------------------------------------------------------
# Copy this file to ".env" and fill in your own values, then
# restart the dev server (`npm run dev`). NEVER commit ".env".
#
# How to get these values:
#   1. Create a free account at https://www.emailjs.com
#   2. Add an Email Service (e.g. Gmail) -> gets SERVICE_ID
#   3. Create an Email Template with placeholders:
#        {{from_name}}  {{reply_to}}  {{subject}}  {{message}}
#      -> this id is TEMPLATE_ID
#   4. Account -> API Keys -> "Public key" -> PUBLIC_KEY
# ============================================================

VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# ============================================================
# PUBLIC CONTACT DETAILS (shown on the site, safe to expose)
# ============================================================

# Public contact email displayed in the Contact + Footer sections
VITE_CONTACT_EMAIL=your.email@example.com

# The public URL of the deployed site (used in sitemap/SEO notes)
VITE_SITE_URL=https://your-domain.example